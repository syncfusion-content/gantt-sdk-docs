@using Syncfusion.EJ2.Gantt

@(Html.EJS().Gantt("Gantt")
    .DataSource((IEnumerable<object>)ViewBag.DataSource)
    .Height("450px")
    .AllowSorting(true)
    .AllowFiltering(true)
    .AllowResizing(true)
    .EnableContextMenu(true)
    .ShowColumnMenu(true)
    .EnableSerialNumber(true)
    .AllowRowDragAndDrop(true)
    .AllowTaskbarDragAndDrop(true)
    .TreeColumnIndex(2)
    .TaskFields(ts => ts
        .Id("TaskID")
        .Name("TaskName")
        .StartDate("StartDate")
        .Duration("Duration")
        .Progress("Progress")
        .ParentID("ParentID"))
    .EditSettings(es => es
        .AllowAdding(true)
        .AllowEditing(true)
        .AllowDeleting(true)
        .AllowTaskbarEditing(true)
        .ShowDeleteConfirmDialog(true))
    .SplitterSettings(sp => sp.ColumnIndex(4))
    .Columns(col =>
    {
        col.Field("TaskID").HeaderText("Task ID").Visible(false).Add();
        col.Field("SerialNumber").HeaderText("S.No").Width("100").AllowFiltering(false).Add();
        col.Field("TaskName").HeaderText("Task Name").AllowReordering(false).Width("280").Add();
        col.Field("StartDate").HeaderText("Start Date").Width("140").Add();
        col.Field("Duration").HeaderText("Duration").AllowEditing(false).Width("130").Add();
        col.Field("Progress").HeaderText("Progress").Add();
    })
    .Toolbar(new List<string>()
    {
        "Add", "Edit", "Update", "Delete",
        "Cancel", "Indent", "Outdent",
        "ExpandAll", "CollapseAll", "Search"
    })
    .Render())