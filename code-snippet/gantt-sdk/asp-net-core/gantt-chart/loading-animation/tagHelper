<ejs-gantt id="Gantt" dataSource="@Model.GanttDataSourceCollection" height="450px" treeColumnIndex="1"
    enableVirtualization="true" allowSorting="true" allowFiltering="true" highlightWeekends="true">

    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate" endDate="EndDate" duration="Duration"
        progress="Progress" parentID="ParentId">
    </e-gantt-taskfields>

    <e-gantt-splittersettings columnIndex="2"></e-gantt-splittersettings>

    <e-gantt-labelsettings leftLabel="TaskName" taskLabel="Progress">
    </e-gantt-labelsettings>

    <e-gantt-loadingindicator indicatorType="Shimmer">
    </e-gantt-loadingindicator>

    <e-gantt-columns>
        <e-gantt-column field="TaskId" headerText="Task ID"></e-gantt-column>
        <e-gantt-column field="TaskName" headerText="Task Name"></e-gantt-column>
        <e-gantt-column field="StartDate" headerText="Start Date"></e-gantt-column>
        <e-gantt-column field="Duration" headerText="Duration"></e-gantt-column>
        <e-gantt-column field="Progress" headerText="Progress"></e-gantt-column>
    </e-gantt-columns>

</ejs-gantt>