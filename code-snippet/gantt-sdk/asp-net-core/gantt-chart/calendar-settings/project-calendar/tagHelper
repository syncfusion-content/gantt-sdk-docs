@page
@model IndexModel
@using Syncfusion.EJ2.Gantt

<ejs-gantt id="Gantt"
           dataSource="@Model.GanttDataSourceCollection"
           height="450px"
           projectStartDate="04/01/2026"
           projectEndDate="04/30/2026"
           workWeek="@(new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday" })"
           includeWeekend="false">

    <e-gantt-taskfields id="TaskId"
                        name="TaskName"
                        startDate="StartDate"
                        duration="Duration"
                        parentID="ParentId">
    </e-gantt-taskfields>

    <e-gantt-labelsettings leftLabel="TaskName">
    </e-gantt-labelsettings>

    <e-gantt-calendarsettings>

        <e-gantt-projectcalendar
            workingTime="@(new List<object>
            {
                new { from = 9, to = 12 },
                new { from = 13, to = 17 }
            })"
            exceptions="@(new List<object>
            {
                new
                {
                    from = new DateTime(2026, 4, 6),
                    to = new DateTime(2026, 4, 6),
                    label = "Extended Working Day",
                    exceptionWorkingTime = new[] { new { from = 8, to = 18 } }
                }
            })">
        </e-gantt-projectcalendar>

    </e-gantt-calendarsettings>

</ejs-gantt>