<ejs-gantt id="Gantt" dataSource="ViewBag.DataSource" height="450px"
           projectStartDate="04/01/2026" projectEndDate="04/30/2026">
    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate"
                        duration="Duration" parentID="ParentId">
    </e-gantt-taskfields>
    <e-gantt-labelsettings leftLabel="TaskName"></e-gantt-labelsettings>
    <e-gantt-calendarsettings>
        <e-gantt-projectcalendar holidays="@(new List<object>
        {
            new
            {
                from = new DateTime(2026, 4, 10),
                to = new DateTime(2026, 4, 10),
                label = "Regional closure"
            },
            new
            {
                from = new DateTime(2026, 4, 17),
                to = new DateTime(2026, 4, 17),
                label = "Public holidays"
            }
        })">
        </e-gantt-projectcalendar>
    </e-gantt-calendarsettings>
    <e-gantt-columns>
        <e-gantt-column field="TaskId" headerText="ID" width="80"></e-gantt-column>
        <e-gantt-column field="TaskName" headerText="Task Name" width="250"></e-gantt-column>
        <e-gantt-column field="StartDate"></e-gantt-column>
        <e-gantt-column field="Duration"></e-gantt-column>
    </e-gantt-columns>
</ejs-gantt>
