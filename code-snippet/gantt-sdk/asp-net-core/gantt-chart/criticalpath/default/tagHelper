<ejs-gantt id="ganttDefault" dataSource="@Model.GanttDataSourceCollection" height="430px"
    toolbar="@( new List<string>() { " CriticalPath" })" enableCriticalPath="true">

    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate" endDate="EndDate" duration="Duration"
        progress="Progress" dependency="Predecessor" parentID="ParentId">
    </e-gantt-taskfields>

    <e-gantt-editsettings allowAdding="true" allowEditing="true" allowDeleting="true" allowTaskbarEditing="true"
        showDeleteConfirmDialog="true">
    </e-gantt-editsettings>
</ejs-gantt>