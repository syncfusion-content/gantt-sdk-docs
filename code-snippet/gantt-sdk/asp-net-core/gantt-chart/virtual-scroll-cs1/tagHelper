@page
@model CoreSamples.Pages.IndexModel
@{
ViewData["Title"] = "Home page";
}

<ejs-gantt id="ganttDefault" dataSource="@Model.GanttDataSourceCollection" height="450px" treeColumnIndex="1"
    enableVirtualization="true" allowSelection="true" highlightWeekends="true">

    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate" endDate="EndDate" duration="Duration"
        progress="Progress" parentID="ParentId">
    </e-gantt-taskfields>

    <e-gantt-columns>
        <e-gantt-column field="TaskId" headerText="Task ID" width="100"></e-gantt-column>
        <e-gantt-column field="TaskName" headerText="Task Name" width="250"></e-gantt-column>
        <e-gantt-column field="StartDate"></e-gantt-column>
        <e-gantt-column field="Duration"></e-gantt-column>
        <e-gantt-column field="Progress"></e-gantt-column>
    </e-gantt-columns>

    <e-gantt-splittersettings columnIndex="2"></e-gantt-splittersettings>

    <e-gantt-labelsettings leftLabel="TaskName" taskLabel="Progress">
    </e-gantt-labelsettings>

</ejs-gantt>