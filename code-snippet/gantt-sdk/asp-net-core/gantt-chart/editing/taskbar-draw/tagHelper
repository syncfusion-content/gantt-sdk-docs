<div class="control-section">
    <ejs-gantt id="Gantt"
               dataSource="Model.GanttDataSourceCollection"
               height="450px"
               projectStartDate="03/28/2019"
               projectEndDate="05/18/2019"
               allowUnscheduledTasks="true">

        <e-gantt-taskfields id="TaskId"
                            name="TaskName"
                            startDate="StartDate"
                            duration="Duration"
                            endDate="EndDate">
        </e-gantt-taskfields>

        <e-gantt-labelsettings leftLabel="TaskName">
        </e-gantt-labelsettings>

        <e-gantt-editsettings allowTaskbarEditing="true"
                              allowTaskbarDragAndDrop="true">
        </e-gantt-editsettings>

    </ejs-gantt>
</div>