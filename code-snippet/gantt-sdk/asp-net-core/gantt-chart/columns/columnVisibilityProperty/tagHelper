@page
@model CoreSamples.Pages.IndexModel

<div style="margin-bottom:20px">
    <label style="padding:10px 10px">Enable or disable visible property</label>
    <ejs-switch id="switch" change="change"></ejs-switch>
</div>

<ejs-gantt id="Gantt" dataSource="@Model.GanttDataSourceCollection" height="430px" treeColumnIndex="1">
    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate" endDate="EndDate" duration="Duration"
        progress="Progress" parentID="ParentId">
    </e-gantt-taskfields>

    <e-gantt-splittersettings position="75%"></e-gantt-splittersettings>

    <e-gantt-columns>
        <e-gantt-column field="TaskId" headerText="Task ID" textAlign="Right" width="90">
        </e-gantt-column>

        <e-gantt-column field="TaskName" headerText="Task Name" textAlign="Left" width="270">
        </e-gantt-column>

        <e-gantt-column field="StartDate" headerText="Start Date" textAlign="Right" width="120">
        </e-gantt-column>

        <e-gantt-column field="Duration" headerText="Duration" textAlign="Right" width="90" visible="false">
        </e-gantt-column>

        <e-gantt-column field="Progress" headerText="Progress" textAlign="Right" width="150">
        </e-gantt-column>
    </e-gantt-columns>
</ejs-gantt>

<script>
    function change(args) {
        var gantt = document.getElementById("Gantt").ej2_instances[0];
        var column = gantt.treeGrid.getColumnByField("Duration");

        column.visible = args.checked;
        gantt.treeGrid.refreshColumns();
    }
</script>