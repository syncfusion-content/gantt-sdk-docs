<ejs-gantt id='Gantt' dataSource="ViewBag.DataSource" height="450px" treeColumnIndex="1">
    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate" endDate="EndDate" duration="Duration"
        progress="Progress" child="SubTasks">
    </e-gantt-taskfields>
    <e-gantt-columns>
        <e-gantt-column field="TaskId" headerText="Task ID" width="100" clipMode="Clip"></e-gantt-column>
        <e-gantt-column field="TaskName" headerText="Task Name" width="180" clipMode="Ellipsis"></e-gantt-column>
        <e-gantt-column field="StartDate" headerText="Start Date" width="150"
            clipMode="EllipsisWithTooltip"></e-gantt-column>
    </e-gantt-columns>
</ejs-gantt>