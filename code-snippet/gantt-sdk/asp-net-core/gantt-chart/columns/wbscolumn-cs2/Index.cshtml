@page
@model CoreSamples.Pages.IndexModel
@{
    ViewData["Title"] = "Home page";
}

<ejs-gantt id="Gantt" dataSource="@Model.GanttData" height="450px" treeColumnIndex="2" allowFiltering="true"
           allowSorting="true" allowSelection="true" allowRowDragAndDrop="true" enableWBS="true" enableAutoWbsUpdate="false"
           projectStartDate="03/31/2024" projectEndDate="05/30/2024" rowHeight="40" taskbarHeight="20" dataBound="dataBound"
           toolbar="@(new List<string>() { "Add", "Edit", "Update", "Delete", "Cancel", "ExpandAll", "CollapseAll" })"
           actionBegin="actionBegin">

    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate" endDate="EndDate" duration="Duration"
                        progress="Progress" dependency="Predecessor" parentID="ParentId">
    </e-gantt-taskfields>

    <e-gantt-editsettings allowAdding="true" allowEditing="true" allowDeleting="true" allowTaskbarEditing="true"
                          showDeleteConfirmDialog="true">
    </e-gantt-editsettings>

    <e-gantt-filtersettings type="Menu"></e-gantt-filtersettings>

    <e-gantt-splittersettings columnIndex="4"></e-gantt-splittersettings>

    <e-gantt-labelsettings taskLabel="${Progress}%"></e-gantt-labelsettings>

    <e-gantt-timelinesettings showTooltip="true">
        <e-timelinesettings-toptier unit="Week" format="dd/MM/yyyy"></e-timelinesettings-toptier>
        <e-timelinesettings-bottomtier unit="Day" count="1"></e-timelinesettings-bottomtier>
    </e-gantt-timelinesettings>

    <e-gantt-eventmarkers>
        <e-gantt-eventmarker day="04/02/2024" label="Project Initiation"></e-gantt-eventmarker>
    </e-gantt-eventmarkers>
    <e-gantt-columns>
        <e-gantt-column field="TaskId" visible="false"></e-gantt-column>
        <e-gantt-column field="WBSCode" headerText="WBS Code" width="150"></e-gantt-column>
        <e-gantt-column field="TaskName" headerText="Task Name" allowReordering="false" width="260"></e-gantt-column>
        <e-gantt-column field="StartDate" headerText="Start Date" width="140"></e-gantt-column>
        <e-gantt-column field="WBSPredecessor" headerText="WBS Predecessor" width="190"></e-gantt-column>
        <e-gantt-column field="Duration" headerText="Duration" allowEditing="false" width="130"></e-gantt-column>
        <e-gantt-column field="Progress" headerText="Progress"></e-gantt-column>
    </e-gantt-columns>

</ejs-gantt>

<script>
    var isRowDropped = false;

    function actionBegin(args) {
        if (args.requestType === 'beforeDrop') {
            isRowDropped = true;
            var gantt = document.getElementById("Gantt").ej2_instances[0];
            gantt.enableAutoWbsUpdate = true;
        }
    }

    function dataBound() {
        if (isRowDropped) {
            var gantt = document.getElementById("Gantt").ej2_instances[0];
            gantt.enableAutoWbsUpdate = false;
            isRowDropped = false;
        }
    }
</script>