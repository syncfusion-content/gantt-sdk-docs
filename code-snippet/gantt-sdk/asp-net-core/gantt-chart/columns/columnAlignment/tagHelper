@{
var AlignmentData = new string[] { "Left", "Right", "Center", "Justify" };
}

<div style="display: flex; align-items: center; margin-bottom: 10px;">
    <label style="margin-right: 10px; font-weight: bold">Align the text for columns:</label>
    <ejs-dropdownlist id="alignment" width="120" dataSource="AlignmentData" index="1" change="changeAlignment">
        <e-dropdownlist-fields text="text" value="value"></e-dropdownlist-fields>
    </ejs-dropdownlist>
</div>

<ejs-gantt id="Gantt" height="370px" dataSource="@Model.GanttDataSourceCollection">
    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate" endDate="EndDate" duration="Duration"
        progress="Progress" parentID="ParentId">
    </e-gantt-taskfields>
    <e-gantt-splittersettings position="75%"></e-gantt-splittersettings>
    <e-gantt-columns>
        <e-gantt-column field="TaskId" headerText="Task ID" textAlign="Right" width="90"></e-gantt-column>
        <e-gantt-column field="TaskName" headerText="Task Name" textAlign="Left" width="170"></e-gantt-column>
        <e-gantt-column field="StartDate" headerText="Start Date" textAlign="Right" format="yMd"
            width="150"></e-gantt-column>
        <e-gantt-column field="Duration" headerText="Duration" textAlign="Right" width="90"></e-gantt-column>
        <e-gantt-column field="Progress" headerText="Progress" textAlign="Right" width="120"></e-gantt-column>
    </e-gantt-columns>
</ejs-gantt>

<script>
    function changeAlignment(args) {
        var gantt = document.getElementById('Gantt').ej2_instances[0];
        var columns = gantt.treeGrid.grid.columns;
        columns.forEach(function (col) {
            col.textAlign = args.value;
        });
        gantt.treeGrid.grid.refreshColumns();
    }
</script>