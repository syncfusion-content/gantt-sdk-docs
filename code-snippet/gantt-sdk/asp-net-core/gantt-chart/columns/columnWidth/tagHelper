<ejs-gantt id="ganttDefault" dataSource="@Model.GanttDataSourceCollection" height="430px" treeColumnIndex="1">
    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate" duration="Duration" progress="Progress" parentID="ParentId"></e-gantt-taskfields>
    <e-gantt-splittersettings position="90%"></e-gantt-splittersettings>
    <e-gantt-columns>
        <e-gantt-column field="TaskId" headerText="Task Id" textAlign="Right" width="90"></e-gantt-column>
        <e-gantt-column field="TaskName" headerText="Task Name" textAlign="Left" width="270"></e-gantt-column>
        <e-gantt-column field="StartDate" headerText="Start Date" textAlign="Right" width="120"></e-gantt-column>
        <e-gantt-column field="Duration" headerText="Duration" textAlign="Right" width="auto"></e-gantt-column>
        <e-gantt-column field="Progress" headerText="Progress" textAlign="Right" width="30%"></e-gantt-column>
    </e-gantt-columns>
</ejs-gantt>