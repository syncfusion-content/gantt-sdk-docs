@page
@model CoreSamples.Pages.IndexModel
@{
ViewData["Title"] = "Home page";
}

<ejs-gantt id="Gantt" dataSource="@Model.GanttDataSourceCollection" height="430px" treeColumnIndex="1">

    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate" endDate="EndDate" duration="Duration"
        progress="Progress" parentID="ParentId">
    </e-gantt-taskfields>

    <e-gantt-splittersettings position="75%"></e-gantt-splittersettings>

    <e-gantt-columns>
        <e-gantt-column field="TaskId" headerText="Task ID" textAlign="Left" width="90"></e-gantt-column>

        <e-gantt-column field="TaskName" headerText="Task Name" textAlign="Left" width="270"></e-gantt-column>

        <e-gantt-column field="StartDate" headerText="Start Date" textAlign="Left" width="120"
            template="#startDateTemplate">
        </e-gantt-column>

        <e-gantt-column field="Duration" headerText="Duration" textAlign="Left" width="150"></e-gantt-column>

        <e-gantt-column field="Progress" headerText="Progress" textAlign="Left" width="120"></e-gantt-column>
    </e-gantt-columns>

</ejs-gantt>

<script type="text/x-template" id="startDateTemplate">
    ${formatDate(StartDate)}
</script>

<script>
    function formatDate(date) {
        var startDate = new Date(date);
        var day = startDate.getDate();
        var month = startDate.toLocaleDateString('default', { month: 'short' });
        var year = startDate.getFullYear();
        return year + '/' + month + '/' + day;
    }
</script>