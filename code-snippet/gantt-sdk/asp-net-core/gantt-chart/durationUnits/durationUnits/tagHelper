<ejs-gantt id="Gantt"
           dataSource="@Model.GanttDataSourceCollection"
           height="450px"
           daysPerWeek="5"
           daysPerMonth="20">

    <e-gantt-splittersettings columnIndex="4">
    </e-gantt-splittersettings>

    <e-gantt-taskfields id="TaskID"
                        name="TaskName"
                        startDate="StartDate"
                        duration="Duration"
                        progress="Progress"
                        durationUnit="DurationUnit"
                        parentID="ParentID">
    </e-gantt-taskfields>

</ejs-gantt>