@page
@model CoreSamples.Pages.IndexModel

<ejs-gantt id="Gantt" dataSource="@Model.GanttData" height="430px">
    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate" endDate="EndDate" duration="Duration" progress="Progress" parentID="ParentId"></e-gantt-taskfields>
    <e-gantt-timelinesettings showWeekend="false"></e-gantt-timelinesettings>
    <e-gantt-columns>
        <e-gantt-column field="TaskId" headerText="Task ID" textAlign="Left" width="100"></e-gantt-column>
        <e-gantt-column field="TaskName" headerText="Task Name" width="250"></e-gantt-column>
        <e-gantt-column field="StartDate" headerText="Start Date" width="150"></e-gantt-column>
        <e-gantt-column field="Duration" headerText="Duration" width="150"></e-gantt-column>
        <e-gantt-column field="Progress" headerText="Progress" width="150"></e-gantt-column>
    </e-gantt-columns>
</ejs-gantt>
