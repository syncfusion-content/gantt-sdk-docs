@page
@model CoreSamples.Pages.IndexModel

@{
ViewData["Title"] = "Home Page";
}

<ejs-gantt id="Gantt" dataSource="@Model.GanttDataSourceCollection" resources="@Model.ProjectResources"
    allowPdfExport="true" toolbar="@(new List<string>() { " PdfExport" })" toolbarClick="toolbarClick"
    pdfQueryCellInfo="pdfQueryCellInfo" height="450px">

    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate" endDate="EndDate" duration="Duration"
        progress="Progress" parentID="ParentId" resourceInfo="ResourceId">
    </e-gantt-taskfields>

    <e-gantt-resourcefields id="ResourceId" name="ResourceName">
    </e-gantt-resourcefields>

    <e-gantt-columns>

        <e-gantt-column field="TaskId" headerText="Task Id" width="80">
        </e-gantt-column>

        <e-gantt-column field="TaskName" headerText="Task Name" width="250">
        </e-gantt-column>

        <e-gantt-column field="ResourceId" headerText="Resources" width="250" template="#columnTemplate">
        </e-gantt-column>

        <e-gantt-column field="StartDate"></e-gantt-column>
        <e-gantt-column field="Duration"></e-gantt-column>
        <e-gantt-column field="Progress"></e-gantt-column>

    </e-gantt-columns>

</ejs-gantt>

<script id="columnTemplate" type="text/x-jsrender">

    ${if(ganttProperties.resourceNames)}

    <div style="display:flex;align-items:center;">

        <img
            src="data:image/jpeg;base64,${ResourcesImage}"
            style="width:40px;height:40px;border-radius:20px;" />

        <span style="margin-left:8px;">
            ${ganttProperties.resourceNames}
        </span>

    </div>

    ${/if}

</script>

<script>

    function toolbarClick(args) {

        var gantt = document.getElementById("Gantt").ej2_instances[0];

        if (args.item.id === "Gantt_pdfexport") {

            gantt.pdfExport();
        }
    }

    function pdfQueryCellInfo(args) {

        if (args.column.field === "ResourceId") {

            if (args.data.hasChildRecords) {

                args.value = ''; // or 'Summary Task'

                return;
            }

            args.value =
                args.data.ganttProperties?.resourceNames || '';

            let imageData = args.data.ResourcesImage ||
                args.data.taskData?.ResourcesImage;

            if (imageData) {
                args.image = {
                    base64: imageData,
                    width: 20,
                    height: 20
                };
            }
        }
    }

</script>