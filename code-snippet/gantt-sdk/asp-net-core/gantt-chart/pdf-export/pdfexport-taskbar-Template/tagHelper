@page
@model CoreSamples.Pages.IndexModel
@{
ViewData["Title"] = "Home page";
}

<ejs-gantt id="Gantt" dataSource="@Model.GanttDataSourceCollection" resources="@Model.ProjectResources" height="450px"
    rowHeight="45" taskbarHeight="35" treeColumnIndex="1" toolbar="@(new List<string>() { " PdfExport" })"
    allowPdfExport="true" toolbarClick="toolbarClick" pdfQueryTaskbarInfo="pdfQueryTaskbarInfo"
    taskbarTemplate="#TaskbarTemplate" parentTaskbarTemplate="#ParentTaskbarTemplate"
    milestoneTemplate="#MilestoneTemplate">

    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate" endDate="EndDate" duration="Duration"
        progress="Progress" parentID="ParentId" resourceInfo="ResourceId">
    </e-gantt-taskfields>

    <e-gantt-resourcefields id="ResourceId" name="ResourceName">
    </e-gantt-resourcefields>

    <e-gantt-columns>
        <e-gantt-column field="TaskId" headerText="Task ID" width="100">
        </e-gantt-column>

        <e-gantt-column field="TaskName" headerText="Task Name" width="250">
        </e-gantt-column>
    </e-gantt-columns>

</ejs-gantt>

<style>
    .custom-milestone {
        width: 30px;
        height: 30px;
        transform: rotate(45deg);
        border: 2px solid #6366f1;
        overflow: hidden;
        position: relative;
        background: white;
    }

    .custom-milestone img {
        width: 40px;
        height: 40px;
        position: absolute;
        top: -5px;
        left: -5px;
        transform: rotate(-45deg);
        object-fit: cover;
    }
</style>

<script id="TaskbarTemplate" type="text/x-template">
    <div class="e-gantt-child-taskbar-inner-div e-gantt-child-taskbar"
         style="height:100%;display:flex;align-items:center;overflow:hidden;">

        <img src="data:image/jpeg;base64,${taskData.ResourcesImage}"
             style="width:35px;height:35px;border-radius:4px;background:white;flex-shrink:0;" />

        <span style="padding-left:6px;
                     color:white;
                     font-size:12px;
                     white-space:nowrap;
                     overflow:hidden;
                     text-overflow:ellipsis;">
            ${taskData.TaskName}
        </span>

    </div>
</script>
<script id="ParentTaskbarTemplate" type="text/x-template">
    <div class="e-gantt-parent-taskbar-inner-div e-gantt-parent-taskbar"
         style="height:100%;">
    </div>
</script>
<script id="MilestoneTemplate" type="text/x-template">
    ${if(taskData.ResourcesImage)}
    <div class="custom-milestone">
        <img src="data:image/jpeg;base64,${taskData.ResourcesImage}" />
    </div>
    ${/if}
</script>
<script>
    function toolbarClick(args) {
        var gantt = document.getElementById("Gantt").ej2_instances[0];

        if (args.item.id === 'Gantt_pdfexport') {
            gantt.pdfExport({
                fileName: "gantt.pdf"
            });
        }
    }

    function pdfQueryTaskbarInfo(args) {

        var image = args.data.taskData
            ? args.data.taskData.ResourcesImage
            : args.data.ResourcesImage;

        if (image) {
            args.taskbarTemplate.image = [{
                base64: image,
                width: 20,
                height: 20
            }];
        }

        args.taskbarTemplate.value = args.data.TaskName;
    }
</script>