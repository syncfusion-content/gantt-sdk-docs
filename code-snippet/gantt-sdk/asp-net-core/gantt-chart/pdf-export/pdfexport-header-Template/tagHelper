@page
@model CoreSamples.Pages.IndexModel
@{
    ViewData["Title"] = "Home page";
}

<ejs-gantt id="Gantt"
           dataSource="@Model.GanttDataSourceCollection"
           height="450px"
           treeColumnIndex="0"
           allowPdfExport="true"
           toolbar="@(new List<string>() { "PdfExport" })"
           toolbarClick="toolbarClick"
           pdfColumnHeaderQueryCellInfo="pdfColumnHeaderQueryCellInfo">

    <e-gantt-taskfields id="TaskId"
                        name="TaskName"
                        startDate="StartDate"
                        endDate="EndDate"
                        duration="Duration"
                        progress="Progress"
                        parentID="ParentId">
    </e-gantt-taskfields>

    <e-gantt-columns>

        <e-gantt-column field="TaskName"
                        headerText="Task Name"
                        width="250"
                        headerTemplate="#projectName">
        </e-gantt-column>

        <e-gantt-column field="StartDate"
                        headerText="Start Date"
                        width="150"
                        headerTemplate="#dateTemplate">
        </e-gantt-column>

    </e-gantt-columns>

</ejs-gantt>

<script type="text/x-template" id="projectName">
    <div style="display:flex;align-items:center;margin-top:10px">
             <img src="https://ej2.syncfusion.com/angular/demos/assets/gantt/images/Task%20name.png"
     width="20"
     height="20" />
        <span style="margin-left:5px;">Task Name</span>
    </div>
</script>
<script type="text/x-template" id="dateTemplate">
    <div style="display:flex;align-items:center;margin-top:10px">
        <img src="https://ej2.syncfusion.com/angular/demos/assets/gantt/images/Start%20date.png"
     width="20"
     height="20" />
        <span style="margin-left:5px;">Start Date</span>
    </div>
</script>

<script>

    function toolbarClick(args) {
        var gantt = document.getElementById("Gantt").ej2_instances[0];

        if (args.item.id === "Gantt_pdfexport") {
            gantt.pdfExport({
                fileName: "new.pdf"
            });
        }
    }

    function pdfColumnHeaderQueryCellInfo(args) {

        var headerImages = {
            "TaskName": "",
            "StartDate": ""
        };
        if (headerImages[args.column.field]) {

            args.headerTemplate.image = [{
                base64: headerImages[args.column.field],
                width: 20,
                height: 20,
            }];

            args.headerTemplate.value = args.column.field;
        }
    }

</script>
