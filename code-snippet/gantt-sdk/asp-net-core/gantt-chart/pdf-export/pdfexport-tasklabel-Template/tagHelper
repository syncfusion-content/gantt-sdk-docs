@page
@model CoreSamples.Pages.IndexModel
@{
ViewData["Title"] = "Home page";
}

<ejs-gantt id="Gantt" dataSource="@Model.GanttDataSourceCollection" resources="@Model.ProjectResources" height="450px"
    treeColumnIndex="1" rowHeight="45" taskbarHeight="30" projectStartDate="03/24/2019" projectEndDate="04/30/2019"
    allowPdfExport="true" allowResizing="true" toolbar="@(new List<string>() { " PdfExport" })"
    toolbarClick="toolbarClick" pdfQueryTaskbarInfo="pdfQueryTaskbarInfo">

    <e-gantt-taskfields id="TaskId" name="TaskName" startDate="StartDate" duration="Duration" progress="Progress"
        parentID="ParentId" resourceInfo="ResourceId">
    </e-gantt-taskfields>

    <e-gantt-resourcefields id="ResourceId" name="ResourceName">
    </e-gantt-resourcefields>

    <e-gantt-labelSettings leftLabel="#LeftLabelTemplate" rightLabel="#RightLabelTemplate" taskLabel="${Progress}%">
    </e-gantt-labelSettings>

    <e-gantt-columns>
        <e-gantt-column field="TaskId" headerText="Task ID" width="120">
        </e-gantt-column>

        <e-gantt-column field="TaskName" headerText="Task Name" width="250">
        </e-gantt-column>
    </e-gantt-columns>

</ejs-gantt>

<script id="LeftLabelTemplate" type="text/x-template">
    <span>${TaskName} [ ${Progress}% ]</span>
</script>

<script id="RightLabelTemplate" type="text/x-template">
    ${if(ganttProperties && ganttProperties.resourceNames)}
        <span>${ganttProperties.resourceNames}</span>
    ${/if}
</script>

<script>
    function toolbarClick(args) {
        var gantt = document.getElementById("Gantt").ej2_instances[0];

        if (args.item.id === "Gantt_pdfexport") {
            gantt.pdfExport({
                fileName: "new.pdf"
            });
        }
    }

    function pdfQueryTaskbarInfo(args) {

        if (args.labelSettings &&
            args.labelSettings.leftLabel &&
            args.data.ganttProperties) {

            args.labelSettings.leftLabel.value =
                args.data.ganttProperties.taskName +
                ' [' +
                args.data.ganttProperties.progress +
                '% ]';
        }

        if (args.labelSettings &&
            args.labelSettings.rightLabel &&
            args.data.ganttProperties.resourceNames) {

            args.labelSettings.rightLabel.value =
                args.data.ganttProperties.resourceNames;

            if (args.data.ResourcesImage) {

                args.labelSettings.rightLabel.image = [{
                    base64: args.data.ResourcesImage,
                    width: 20,
                    height: 20
                }];
            }
        }
    }
</script>